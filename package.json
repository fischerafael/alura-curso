{
  "name": "projeto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "prisma:generate": "prisma generate --schema=src/backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/backend/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=src/backend/prisma/schema.prisma",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.10",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
